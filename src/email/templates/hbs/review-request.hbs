<!DOCTYPE html>
<html lang="{{locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{subject}}</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f5f5f5; line-height: 1.6;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f5f5f5; padding: 20px;">
        <tr>
            <td align="center">
                <table width="650" cellpadding="0" cellspacing="0" border="0" style="max-width: 650px; background-color: white; border-radius: 12px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);">

                    <!-- Header -->
                    <tr>
                        <td style="background-color: #3A7B59; padding: 30px; text-align: center; color: white; border-radius: 12px 12px 0 0;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="padding: 20px 25px;">
                                        {{#if domainLogoUrl}}
                                        <img src="{{domainLogoUrl}}" alt="{{domainName}} Logo" width="120" style="max-width: 120px; height: auto; display: block; margin: 0 auto;">
                                        {{else}}
                                        <div style="font-size: 22px; font-weight: 700; color: white;">{{domainName}}</div>
                                        {{/if}}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 45px 35px; background-color: #fffef7;">

                            {{#if isFrench}}
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="color: #3A7B59; font-size: 28px; font-weight: 700; text-align: center; padding-bottom: 30px; letter-spacing: -0.5px;">
                                        Parce que votre avis compte
                                    </td>
                                </tr>
                            </table>

                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="color: #333; font-size: 16px; line-height: 1.7; padding-bottom: 18px;">
                                        Ce fut un plaisir de vous accueillir au {{domainName}}. Nous espérons que vous avez apprécié découvrir notre domaine et nos vins.
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color: #333; font-size: 16px; line-height: 1.7; padding-bottom: 30px;">
                                        Parce que votre avis compte, nous vous serions très reconnaissants de laisser un avis Google : cela nous aide à nous améliorer et permet à d'autres personnes de nous découvrir. Promis, cela ne prendra qu'une petite minute.
                                    </td>
                                </tr>
                            </table>
                            {{else}}
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="color: #3A7B59; font-size: 28px; font-weight: 700; text-align: center; padding-bottom: 30px; letter-spacing: -0.5px;">
                                        We want to hear what you think
                                    </td>
                                </tr>
                            </table>

                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="color: #333; font-size: 16px; line-height: 1.7; padding-bottom: 18px;">
                                        It was a pleasure to welcome you at {{domainName}}. We hope you enjoyed learning more about our domain and our wines.
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color: #333; font-size: 16px; line-height: 1.7; padding-bottom: 30px;">
                                        If you have 2 minutes, we would greatly appreciate if you could take the time to leave us a google review - it helps us improve and other people to discover us.
                                    </td>
                                </tr>
                            </table>
                            {{/if}}

                            <!-- CTA -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center" style="padding: 10px 0 35px 0;">
                                        <a href="{{googleReviewUrl}}" style="display: inline-block; background-color: #3A7B59; color: white; padding: 14px 28px; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; box-shadow: 0 4px 12px rgba(58, 123, 89, 0.3);">{{#if isFrench}}Je laisse un avis{{else}}Leave a Review{{/if}}</a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Sign-off -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="color: #333; font-size: 16px; line-height: 1.7;">
                                        {{#if isFrench}}
                                        <p style="margin: 0 0 4px 0;">Vigneronnement,</p>
                                        <p style="margin: 0;">L'équipe {{domainName}}</p>
                                        {{else}}
                                        <p style="margin: 0 0 4px 0;">Best regards,</p>
                                        <p style="margin: 0;">The {{domainName}} team.</p>
                                        {{/if}}
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #3A7B59; padding: 30px 20px; text-align: center; color: white; border-radius: 0 0 12px 12px;">
                            <table width="500" cellpadding="0" cellspacing="0" border="0" align="center" style="max-width: 500px;">
                                <tr>
                                    <td width="70%" valign="middle" style="text-align: left;">
                                        <table cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td width="50" valign="middle" style="padding-right: 15px;">
                                                    <img src="{{appLogoUrl}}" alt="Rose des Vins Logo" width="40" height="40" style="border-radius: 50%; display: block;">
                                                </td>
                                                <td valign="middle">
                                                    <div style="font-size: 18px; font-weight: 500; color: white;">Rose des Vins</div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td width="30%" valign="middle" style="text-align: right;">
                                        <a href="https://rosedesvins.co/#contact" style="font-size: 16px; font-weight: 500; color: white; text-decoration: none;">Contact</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
